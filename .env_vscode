if [[ "$TERM_PROGRAM" == "vscode" ]] && command -v code &>/dev/null; then
  if _vscode_integration=$(code --locate-shell-integration-path zsh 2>/dev/null) &&
      [[ -f "$_vscode_integration" && -r "$_vscode_integration" ]]; then
    source "$_vscode_integration"
  fi
  unset _vscode_integration
fi
